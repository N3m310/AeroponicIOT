# ============================================================
# AeroponicIOT — .gitignore
# ============================================================

# --- .NET Build Artifacts ---
bin/
obj/
*.user
*.suo
*.DotSettings.user
*.csproj.lscache

# --- NuGet ---
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json

# --- VS / Rider ---
.vs/
.idea/
*.swp
*~
.vscode/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Docker ---
docker-compose.override.yml

# --- Environment ---
.env
.env.*
!.env.example

# --- Logs ---
*.log
logs/

# --- Database ---
*.db
*.mdf
*.ldf

# --- Firmware build artifacts ---
firmware/**/build/
firmware/**/.pio/

# --- Codex / AI tooling build cache ---
.codex-build/

# --- Test results ---
TestResults/
*.trx
*.coverage
